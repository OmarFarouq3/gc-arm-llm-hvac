+# 9. the limits match the intervals actually mined from this plant (results/breakpoints.json):
+#    CT_APPROACH_1 is cut at [8.0, 9.8] and CHL_DT_1 at [1.4, 3.6, ...], so the top / bottom
+#    intervals must raise an alarm, and the healthy middle ones must not
+import json
+bp = json.loads((bt.ROOT / "results" / "breakpoints.json").read_text())
+approach_limit = next(l["high"] for l in S["limits"] if l["name"] == "high_approach")
+assert bp["CT_APPROACH_1"]["breaks"][-1] >= approach_limit
+for item, expected in [("CT_APPROACH_1=>=9.8", 1), ("CT_APPROACH_1=[8,9.8)", 0),
+                       ("CHL_DT_1=<1.4", 1), ("CHL_DT_1=[1.4,3.6)", 1), ("CHL_DT_1=[3.6,5.6)", 0),
+                       ("CHL_COP_1=<1.9", 1), ("CHL_COP_1=[1.9,2.9)", 0)]:
+    assert bt.classify_rule({"antecedent": (item,), "consequent": ()}, S)["anomaly"] == expected, item
