# Copy this file to .env and fill in your own values. Never commit .env.
# API key for the LLM endpoint; any non-empty value works for a local Ollama server.
OPENAI_API_KEY=your-key-here
# OpenAI-compatible LLM endpoint (Ollama default shown).
LLM_BASE_URL=http://localhost:11434/v1
# Model name on that endpoint; overrides llm.model in config.yaml.
LLM_MODEL=qwen3.5:4b
# Folder with the unzipped LBNL chiller-plant CSV files and documentation PDF.
DATA_DIR=D:/path/to/LBNL_FDD_Data_Sets_Chiller_Plant_all_3
# Hugging Face cache for the embedding model (set to a drive with free space, e.g. D:/hf_cache).
HF_HOME=D:/path/to/hf_cache
